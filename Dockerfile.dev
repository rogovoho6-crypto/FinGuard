FROM python:3.11-slim AS backend
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 FINGUARD_DATA_DIR=/data
COPY requirements.txt requirements-test.txt ./
RUN pip install --no-cache-dir -r requirements-test.txt && mkdir /data && chown 10001:10001 /data
COPY backend/ ./backend/
USER 10001:10001
EXPOSE 8765
CMD ["python", "-m", "uvicorn", "backend.dev:create_dev_app", "--factory", "--host", "0.0.0.0", "--port", "8765", "--reload", "--reload-dir", "/app/backend"]

FROM node:24-alpine AS frontend
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.25.0 --activate
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
EXPOSE 5173
CMD ["pnpm", "exec", "vite", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]
